NODE_ENV=development
PORT=5001
# Comma-separated when more than one web origin is permitted
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/slotbot
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Microsoft Entra ID / API token validation
ENTRA_TENANT_ID=<directory-tenant-id>
ENTRA_API_CLIENT_ID=<API-app-registration-client-id>

# Optional Microsoft 365 room-calendar sync
MS365_ENABLED=false
MS_TENANT_ID=<directory-tenant-id>
MS_CLIENT_ID=<app-registration-client-id>
MS_CLIENT_SECRET=<client-secret>
MS_ORGANIZER_EMAIL=<service-account-or-organizer-email>
MS_TIMEZONE=Asia/Kolkata
